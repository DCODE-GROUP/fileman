{
    "name": "dcodegroup/fileman",
    "description": "Laravel package for managing files.",
    "authors": [
        {
            "name": "Dcode",
            "email": "admin@dcode.com.au"
        }
    ],
    "require": {
        "php" : "^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "league/flysystem": "^1.1|^3.0",
        "league/flysystem-aws-s3-v3": "^1.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "DcodeGroup\\Fileman\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DcodeGroup\\Fileman\\FileManServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "ergebnis/composer-normalize": "^2.45|^2.52",
        "larastan/larastan": "^3.0|^3.9",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^9.9|^11.0"
    }
}
